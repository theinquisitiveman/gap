{
  "version": 1,
  "about": "Colloquial Kabuli Dari for heritage learners. All items start as 'draft' and become 'reviewed' once a native Kabuli speaker confirms them (in-app corrections + npm run apply-corrections).",
  "sources": [
    "Author knowledge of colloquial Kabuli Dari (unverified draft)",
    "Iranica, 'Kāboli (colloquial Persian)': https://iranicaonline.org/articles/kaboli-colloquial-persian",
    "A. R. Salim, Conversational vs formal Dari handout (UC Berkeley, 2023): https://blc.berkeley.edu/wp-content/uploads/2023/04/Salim-handout-Sp23.pdf",
    "Transparent Language Dari blog, Greetings: https://blogs.transparent.com/dari/2011/04/03/dari-greetings/",
    "Indiana University CeLCAR Dari survival phrases: https://celcar.indiana.edu/materials/survival-phrases.html"
  ],
  "units": [
    {
      "id": "u1",
      "title": "Greetings & respect",
      "titleDari": "سلام و احوالپرسی",
      "color": "green",
      "lessons": [
        {
          "id": "u1-l1",
          "title": "Hello",
          "items": [
            { "id": "salaam", "roman": "salaam", "dari": "سلام", "en": "hello", "status": "draft" },
            { "id": "salaam-alaikum", "roman": "salaam alaikum", "dari": "السلام علیکم", "en": "peace be upon you (hello)", "notes": "The respectful greeting, especially to elders.", "status": "draft" },
            { "id": "wa-alaikum", "roman": "wa alaikum salaam", "dari": "و علیکم السلام", "en": "and peace upon you (reply)", "status": "draft" },
            { "id": "khosh-aamadi", "roman": "khosh aamadi", "dari": "خوش آمدی", "en": "welcome", "notes": "To one person, informal. Polite/plural: khosh aamaden.", "status": "draft" },
            { "id": "bale", "roman": "bale", "dari": "بلی", "en": "yes", "status": "draft" },
            { "id": "ne", "roman": "ne", "dari": "نی", "en": "no", "notes": "Kabuli 'ne'; written/formal 'na' (نه).", "status": "draft" }
          ]
        },
        {
          "id": "u1-l2",
          "title": "How are you?",
          "items": [
            { "id": "chetor-asti", "roman": "chetor asti?", "dari": "چطور استی؟", "en": "how are you? (informal)", "notes": "Formal: chetor hastid?", "status": "draft" },
            { "id": "chetor-asten", "roman": "chetor asten?", "dari": "چطور استین؟", "en": "how are you? (polite)", "notes": "Use with elders and strangers.", "status": "draft" },
            { "id": "khub-astum", "roman": "khub astum", "dari": "خوب استم", "en": "I am well", "notes": "Formal: khub hastam.", "status": "draft" },
            { "id": "jor-asti", "roman": "jor asti?", "dari": "جور استی؟", "en": "are you doing well?", "notes": "Very Kabuli; 'jor' = well, healthy, fixed.", "status": "draft" },
            { "id": "shukr", "roman": "shukr", "dari": "شکر", "en": "thank God (I'm fine)", "status": "draft" },
            { "id": "chi-gap-as", "roman": "chi gap as?", "dari": "چی گپ اس؟", "en": "what's up?", "notes": "Literally 'what's the talk?'. Formal: che gap ast?", "status": "draft" }
          ]
        },
        {
          "id": "u1-l3",
          "title": "Thanks & goodbye",
          "items": [
            { "id": "tashakur", "roman": "tashakur", "dari": "تشکر", "en": "thank you", "status": "draft" },
            { "id": "mehrabani", "roman": "mehrabani", "dari": "مهربانی", "en": "thanks, that's kind", "notes": "Also used like 'please' when offered something.", "status": "draft" },
            { "id": "lutfan", "roman": "lutfan", "dari": "لطفاً", "en": "please", "status": "draft" },
            { "id": "bebakhshen", "roman": "bebakhshen", "dari": "ببخشین", "en": "excuse me / sorry", "notes": "Formal: bebakhshid.", "status": "draft" },
            { "id": "khuda-haafiz", "roman": "khuda haafiz", "dari": "خدا حافظ", "en": "goodbye", "status": "draft" },
            { "id": "ba-amaan-e-khuda", "roman": "ba amaan-e khuda", "dari": "به امان خدا", "en": "go safely (in God's care)", "status": "draft" }
          ]
        },
        {
          "id": "u1-l4",
          "title": "Names & kindness",
          "items": [
            { "id": "jaan", "roman": "jaan", "dari": "جان", "en": "dear (after a name)", "notes": "Ahmad jaan, Khaala jaan — warm and respectful.", "status": "draft" },
            { "id": "naamet-chi-as", "roman": "naamet chi as?", "dari": "نامت چی اس؟", "en": "what's your name?", "notes": "Polite: naametaan chi as? Formal: naam-e shuma chist?", "status": "draft" },
            { "id": "naamem-as", "roman": "naamem Ahmad as", "dari": "نامم احمد اس", "en": "my name is Ahmad", "status": "draft" },
            { "id": "az-didanet", "roman": "az didanet khosh shudum", "dari": "از دیدنت خوش شدم", "en": "nice to meet you", "status": "draft" },
            { "id": "monda-nabaashi", "roman": "monda nabaashi", "dari": "مانده نباشی", "en": "may you not be tired", "notes": "Said to someone working or arriving from a journey.", "status": "draft" },
            { "id": "zinda-baashi", "roman": "zinda baashi", "dari": "زنده باشی", "en": "thank you (may you live long)", "notes": "Classic reply to 'monda nabaashi'.", "status": "draft" }
          ]
        }
      ]
    },
    {
      "id": "u2",
      "title": "Family",
      "titleDari": "فامیل",
      "color": "blue",
      "lessons": [
        {
          "id": "u2-l1",
          "title": "Parents & siblings",
          "items": [
            { "id": "madar", "roman": "madar", "dari": "مادر", "en": "mother", "status": "draft" },
            { "id": "padar", "roman": "padar", "dari": "پدر", "en": "father", "status": "draft" },
            { "id": "beraadar", "roman": "beraadar", "dari": "برادر", "en": "brother", "status": "draft" },
            { "id": "khwaar", "roman": "khwaar", "dari": "خواهر", "en": "sister", "status": "draft" },
            { "id": "bacha", "roman": "bacha", "dari": "بچه", "en": "boy / son", "status": "draft" },
            { "id": "dokhtar", "roman": "dokhtar", "dari": "دختر", "en": "girl / daughter", "status": "draft" }
          ]
        },
        {
          "id": "u2-l2",
          "title": "Aunts, uncles, grandparents",
          "items": [
            { "id": "khaala", "roman": "khaala", "dari": "خاله", "en": "aunt (mother's sister)", "status": "draft" },
            { "id": "amma", "roman": "amma", "dari": "عمه", "en": "aunt (father's sister)", "status": "draft" },
            { "id": "kaakaa", "roman": "kaakaa", "dari": "کاکا", "en": "uncle (father's brother)", "status": "draft" },
            { "id": "maamaa", "roman": "maamaa", "dari": "ماما", "en": "uncle (mother's brother)", "notes": "Careful: in Afghan Dari 'maamaa' is your mother's brother, not 'mom'.", "status": "draft" },
            { "id": "madar-kalaan", "roman": "madar kalaan", "dari": "مادر کلان", "en": "grandmother", "notes": "Many families say 'bibi jaan'.", "status": "draft" },
            { "id": "padar-kalaan", "roman": "padar kalaan", "dari": "پدر کلان", "en": "grandfather", "notes": "Many families say 'baba jaan' or 'agha jaan'.", "status": "draft" }
          ]
        },
        {
          "id": "u2-l3",
          "title": "My family",
          "items": [
            { "id": "madarem", "roman": "madarem", "dari": "مادرم", "en": "my mother", "status": "draft" },
            { "id": "padaret", "roman": "padaret", "dari": "پدرت", "en": "your father", "status": "draft" },
            { "id": "famil", "roman": "famil", "dari": "فامیل", "en": "family", "status": "draft" },
            { "id": "khaana", "roman": "khaana", "dari": "خانه", "en": "home / house", "status": "draft" },
            { "id": "madarem-khub-as", "roman": "madarem khub as", "dari": "مادرم خوب اس", "en": "my mother is well", "notes": "Kabuli 'as' for formal 'ast'.", "status": "draft" },
            { "id": "famil-etaan-khub-as", "roman": "famil-etaan khub as?", "dari": "فامیل تان خوب اس؟", "en": "is your family well?", "status": "draft" }
          ]
        },
        {
          "id": "u2-l4",
          "title": "Talking about family",
          "items": [
            { "id": "i-beraadarem-as", "roman": "i beraadarem as", "dari": "ای برادرم اس", "en": "this is my brother", "notes": "Kabuli 'i' for formal 'in' (this).", "status": "draft" },
            { "id": "u-khwaarem-as", "roman": "u khwaarem as", "dari": "او خواهرم اس", "en": "she is my sister", "status": "draft" },
            { "id": "chand-beraadar-daari", "roman": "chand beraadar daari?", "dari": "چند برادر داری؟", "en": "how many brothers do you have?", "status": "draft" },
            { "id": "du-khwaar-daarum", "roman": "du khwaar daarum", "dari": "دو خواهر دارم", "en": "I have two sisters", "notes": "Formal: du khwaahar daaram.", "status": "draft" },
            { "id": "toy", "roman": "toy", "dari": "توی", "en": "wedding", "status": "draft" },
            { "id": "mehmaan", "roman": "mehmaan", "dari": "مهمان", "en": "guest", "status": "draft" }
          ]
        }
      ]
    },
    {
      "id": "u3",
      "title": "Me & you",
      "titleDari": "مه و تو",
      "color": "purple",
      "lessons": [
        {
          "id": "u3-l1",
          "title": "Pronouns",
          "items": [
            { "id": "ma", "roman": "ma", "dari": "مه", "en": "I", "notes": "Kabuli 'ma'; formal 'man' (من).", "status": "draft" },
            { "id": "tu", "roman": "tu", "dari": "تو", "en": "you (informal)", "status": "draft" },
            { "id": "shuma", "roman": "shuma", "dari": "شما", "en": "you (polite / plural)", "status": "draft" },
            { "id": "u", "roman": "u", "dari": "او", "en": "he / she", "status": "draft" },
            { "id": "maa", "roman": "maa", "dari": "ما", "en": "we", "status": "draft" },
            { "id": "unaa", "roman": "unaa", "dari": "اونا", "en": "they", "notes": "Formal: aanhaa (آنها).", "status": "draft" }
          ]
        },
        {
          "id": "u3-l2",
          "title": "Where are you from?",
          "items": [
            { "id": "az-kujaa-asti", "roman": "az kujaa asti?", "dari": "از کجا استی؟", "en": "where are you from?", "status": "draft" },
            { "id": "az-kabul-astum", "roman": "ma az Kabul astum", "dari": "مه از کابل استم", "en": "I am from Kabul", "status": "draft" },
            { "id": "afghan-astum", "roman": "ma Afghan astum", "dari": "مه افغان استم", "en": "I am Afghan", "status": "draft" },
            { "id": "u-khub-as", "roman": "u khub as", "dari": "او خوب اس", "en": "he / she is well", "status": "draft" },
            { "id": "maa-khub-astem", "roman": "maa khub astem", "dari": "ما خوب استیم", "en": "we are well", "notes": "Formal: maa khub hastim.", "status": "draft" },
            { "id": "watan", "roman": "watan", "dari": "وطن", "en": "homeland", "status": "draft" }
          ]
        },
        {
          "id": "u3-l3",
          "title": "Learning Dari",
          "items": [
            { "id": "dari-yaad-megirum", "roman": "ma dari yaad megirum", "dari": "مه دری یاد میگیرم", "en": "I am learning Dari", "status": "draft" },
            { "id": "kami-kami", "roman": "kami kami dari gap mezanum", "dari": "کمی کمی دری گپ میزنم", "en": "I speak a little Dari", "notes": "'gap zadan' = to talk (colloquial).", "status": "draft" },
            { "id": "mefaamum", "roman": "mefaamum", "dari": "میفامم", "en": "I understand", "notes": "Kabuli drops the h: formal mefahmam.", "status": "draft" },
            { "id": "namefaamum", "roman": "namefaamum", "dari": "نمیفامم", "en": "I don't understand", "status": "draft" },
            { "id": "yak-dafa-degaa", "roman": "yak dafa degaa bogo", "dari": "یک دفه دیگه بگو", "en": "say it once more", "status": "draft" },
            { "id": "aasta-gap-bezan", "roman": "aasta gap bezan", "dari": "آهسته گپ بزن", "en": "speak slowly", "status": "draft" }
          ]
        }
      ]
    },
    {
